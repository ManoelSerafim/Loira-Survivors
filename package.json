{
  "name": "loira-survivors",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Loira Survivors: A Jornada até Portugal — um roguelite de sobrevivência pixel art.",
  "scripts": {
    "dev": "vite",
    "dev:multi": "npm run dev",
    "dev:server": "npm --prefix backend run dev",
    "build:server": "npm --prefix backend run build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract": "node scripts/extract-sprites.mjs"
  },
  "dependencies": {
    "colyseus.js": "^0.16.15",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
